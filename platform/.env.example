# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=production

# Signs the Platform login session cookie. Portal users/roles live in
# Directus (seeded by ops/seed-directus-portal-users.mjs); Platform maps
# Directus role names → session roles and Camunda candidate groups
# (see platform/src/users.js).
SESSION_SECRET=generate-your-own-random-string

# Set both to true when the portal is behind an HTTPS reverse proxy.
# Leave false when accessing http://VM-IP:4000 directly.
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false

DIRECTUS_URL=http://localhost:8055
# Must match ADMIN_EMAIL / ADMIN_PASSWORD in directus/api/.env — the
# Platform BFF authenticates as this account for schema/items API calls
# (separate from portal demo users such as applicant@example.com).
DIRECTUS_SERVICE_EMAIL=admin@example.com
DIRECTUS_SERVICE_PASSWORD=change-me

CAMUNDA_URL=http://localhost:8080/engine-rest

# Optional. When set, GET /api/public/service-summary requires header X-Api-Key
# (or ?apiKey=) matching this value. Leave unset for open read access.
# SERVICE_SUMMARY_API_KEY=change-me

# Optional. Shared secret for GitHub Actions DEV→UAT promotion
# (POST /api/ci/promote-schema and /api/ci/promote-camunda). Must match the
# CI_PROMOTE_API_KEY repo secret. Leave unset to disable CI promote.
# CI_PROMOTE_API_KEY=change-me

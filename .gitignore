# Dependencies — regenerate via the relevant package manager, never commit
node_modules/
node_modules*/

# Secrets — live credentials, never commit
.env
.env.*
# ...except the templates, which are meant to be committed
!.env.example
!**/.env.example

# Runtime data / generated at run time
directus/api/data.db
*.log
*.pid

# Camunda Postgres JDBC driver (downloaded by ops/ensure-postgres.*)
camunda-module/configuration/userlib/postgresql-*.jar

# Locally downloaded dev tool runtimes (JDK, Node, Postgres installer) — not source
/.tools/

# Claude Code local session/config data
.claude/

# Camunda Platform Run — downloaded binary distribution, not source
camunda-module/camunda-run.zip
camunda-module/internal/
camunda-module/camunda-h2-default/

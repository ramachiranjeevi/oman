# Copy this file to .env and fill in real values. Never commit .env itself.

# Directus's own instance secret/signing keys — generate fresh UUIDs per
# environment, don't reuse across dev/UAT/prod. On Linux/Mac: `uuidgen`.
# On Windows PowerShell: `[guid]::NewGuid()`.
KEY=generate-your-own-uuid
SECRET=generate-your-own-uuid

DB_CLIENT=sqlite3
DB_FILENAME=./data.db

# Bootstraps the first admin user on a fresh (empty) database only — has no
# effect once data.db already exists. Must match DIRECTUS_SERVICE_EMAIL /
# DIRECTUS_SERVICE_PASSWORD in platform/.env, since the Platform BFF logs
# in as this account to call Directus's REST API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

PORT=8055
PUBLIC_URL=http://localhost:8055

# Lightweight-backend trim: no admin app UI, no websockets, no extension
# loading — we only use the REST data/schema/forms API from the Platform
# BFF. Real Directus underneath, just running with a smaller surface.
SERVE_APP=false
WEBSOCKETS_ENABLED=false
EXTENSIONS_AUTO_RELOAD=false
EXTENSIONS_LIMIT=0
RATE_LIMITER_ENABLED=false
CACHE_ENABLED=false
TELEMETRY=false
